BOT_TOKEN=123:ABC
CHANNEL_ID=-1001234567890
ADMIN_IDS=123456789
DB_PATH=./data/store.db
LOG_LEVEL=INFO
LATENCY_LOG_FILE=./data/latency.log

# Comma-separated channel IDs for backup copies (files forwarded here too).
BACKUP_CHANNEL_IDS=

# Comma-separated chat refs (@channel or -100123...) for force-join gate.
FORCE_JOIN_CHATS=

# TTL auto-expire scanner interval in MINUTES:
#   0 = auto-expire OFF (files never removed automatically)
#   1 = sweep every 1 minute
#   30 = sweep every 30 minutes (default)
EXPIRY_SCAN_INTERVAL_M=30
