BOT_TOKEN=123:ABC
CHANNEL_ID=-1001234567890
ADMIN_IDS=123456789
DB_PATH=./data/store.db

# Console log verbosity (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Also append logs to this file ("" = console only).
LOG_FILE=./data/bot.log

# Display + logging timezone (expiry times shown to users).
# Storage stays UTC internally. Example: Asia/Dhaka, Asia/Kolkata, UTC.
TZ=Asia/Dhaka

# CSV latency records (epoch,code,user_id,latency_ms,success).
LATENCY_LOG_FILE=./data/latency.log

# Comma-separated channel IDs for backup copies (files forwarded here too).
BACKUP_CHANNEL_IDS=

# Comma-separated chat refs (@channel or -100123...) for force-join gate.
FORCE_JOIN_CHATS=

# TTL auto-expire scanner interval in MINUTES:
#   0 = auto-expire OFF (files never removed automatically)
#   1 = sweep every 1 minute
#   30 = sweep every 30 minutes (default)
EXPIRY_SCAN_INTERVAL_M=30

# Default file TTL in DAYS when the upload caption has no /ttl:
#   7 = 1 week (default)   0 = never expire   30 = 1 month ...
# Override per file: caption "/ttl 2h ..." or /expire <code> <dur|off>
DEFAULT_TTL_DAYS=7
